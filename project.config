[project]
	description = Atom package providing side panel with class information: constants, properties and methods with go-to functionality provided by php-integrator-base package.
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Maciej Maliborski (maliboo)
[access "refs/for/refs/*"]
	read = group user/Maciej Maliborski (maliboo)
	push = group user/Maciej Maliborski (maliboo)
	label-Code-Review = -2..+2 group user/Maciej Maliborski (maliboo)
	label-Verified = -1..+1 group user/Maciej Maliborski (maliboo)
	rebase = group user/Maciej Maliborski (maliboo)
	removeReviewer = group user/Maciej Maliborski (maliboo)
	submit = group user/Maciej Maliborski (maliboo)
[access "refs/heads/*"]
	read = group user/Maciej Maliborski (maliboo)
	create = group user/Maciej Maliborski (maliboo)
	push = +force group user/Maciej Maliborski (maliboo)
	pushMerge = group user/Maciej Maliborski (maliboo)
[access "refs/tags/*"]
	push = +force group user/Maciej Maliborski (maliboo)
	pushTag = group user/Maciej Maliborski (maliboo)
	pushSignedTag = group user/Maciej Maliborski (maliboo)
